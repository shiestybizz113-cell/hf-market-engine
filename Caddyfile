# hf-market-engine TLS edge.
#
# Set APP_DOMAIN to your public hostname (e.g. app.example.com). Caddy will
# automatically provision Let's Encrypt certificates. For localhost testing,
# leave APP_DOMAIN unset (defaults to localhost and uses Caddy's internal CA).
#
# Routing:
#   /api/*  -> backend:8000 (FastAPI)
#   /*      -> frontend:80  (nginx static SPA)

{$APP_DOMAIN:localhost} {
	encode gzip zstd

	# API. Overwrite client-IP provenance at the trusted edge so application
	# rate limits cannot be bypassed with a spoofed X-Forwarded-For header.
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# Static SPA
	handle {
		reverse_proxy frontend:80
	}

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	log {
		output stdout
		format console
	}
}
