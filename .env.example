# ============================================================
# hf-market-engine environment configuration
# Copy to .env and fill in. NEVER commit .env to git.
# Production: docker compose -f docker-compose.prod.yml up -d --build
# ============================================================

# Public hostname that Caddy serves (Let's Encrypt auto-TLS).
# Leave unset / localhost for local testing (Caddy internal CA).
APP_DOMAIN=app.example.com

# ---- Security -------------------------------------------------
# Strong random value, >= 32 chars. Required in production.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated allowed browser origins. Required in production.
# "*" is never allowed in production.
CORS_ORIGINS=https://app.example.com

# ---- MongoDB --------------------------------------------------
# IMPORTANT: keep these passwords alphanumeric-only — special
# characters break the connection string.
MONGODB_DB=hf_market_engine
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_APP_USER=app
MONGO_APP_PASSWORD=change-me-app-password

# ---- Uvicorn --------------------------------------------------
# Worker processes. Async app can also run fine with 1 worker.
APP_WORKERS=2

# ---- Market data (optional until wired) -----------------------
COINGECKO_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
REDIS_URL=redis://localhost:6379

# ---- Stripe (optional until wired) ----------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ADVANCED=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_WHITELABEL=price_...
