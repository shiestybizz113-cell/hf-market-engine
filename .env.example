# ============================================================
# hf-market-engine environment configuration
# Copy to .env and fill in. NEVER commit .env to git.
# Production: docker compose -f docker-compose.prod.yml up -d --build
# ============================================================

# Public hostname that Caddy serves (Let's Encrypt auto-TLS).
APP_DOMAIN=app.example.com

# ---- Security -------------------------------------------------
# Strong random value, >= 32 chars. Required in production.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated allowed browser origins. Required in production.
# "*" is never allowed in production.
CORS_ORIGINS=https://app.example.com

# ---- MongoDB --------------------------------------------------
# Prefer URL-safe/alphanumeric passwords because these values are interpolated
# into the authenticated Mongo connection URI by docker-compose.prod.yml.
MONGODB_DB=hf_market_engine
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root-password
MONGO_APP_USER=app
MONGO_APP_PASSWORD=change-me-app-password

# ---- Uvicorn --------------------------------------------------
# Shared state is Mongo-backed, so multiple workers are supported.
APP_WORKERS=2

# ---- Core market data -----------------------------------------
# demo = explicitly labeled simulation; live = real providers only.
# Live mode NEVER falls back to synthetic data.
MARKET_DATA_MODE=demo
COINGECKO_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# ---- Capital V2 infrastructure feeds --------------------------
# Optional canonical JSON endpoints. When blank, ASIC/GPU reference catalogs
# remain USER_ASSUMPTION and energy market context is UNAVAILABLE. Nothing is
# silently promoted to live.
#
# HARDWARE_OFFERS_URL accepts {"offers":[{
#   "model":"S21 Pro","price_usd":3500,"provider":"vendor",
#   "observed_at":"2026-08-13T10:00:00Z","condition":"new",
#   "region":"US","hashrate_ths":234,"power_watts":3510
# }]}
#
# GPU_OFFERS_URL accepts {"offers":[{
#   "gpu_model":"H100","price_per_gpu_hour":2.4,"provider":"cloud",
#   "region":"us-west","billing_model":"spot","observed_at":"..."
# }]}
#
# ENERGY_PRICES_URL accepts {"prices":[{
#   "region":"CAISO-SP15","price_usd_mwh":45,"price_type":"wholesale",
#   "provider":"grid_feed","observed_at":"..."
# }]}
HARDWARE_OFFERS_URL=
HARDWARE_PROVIDER_ID=hardware_feed
GPU_OFFERS_URL=
GPU_PROVIDER_ID=gpu_feed
ENERGY_PRICES_URL=
ENERGY_PROVIDER_ID=energy_feed
INFRA_PROVIDER_BEARER_TOKEN=
INFRA_PROVIDER_TIMEOUT=10

# ---- Shared cache / scale -------------------------------------
# Production compose provides this Redis service. Keep cache/state that can be
# regenerated out of Mongo; evidence facts themselves remain Mongo-backed.
REDIS_URL=redis://redis:6379

# ---- AI Capital Council ---------------------------------------
OPENAI_API_KEY=
GROK_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=200
AI_TEMPERATURE=0.4
AI_TIMEOUT=20
AI_CACHE_TTL=900

# ---- Stripe ---------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ADVANCED=price_...
STRIPE_PRICE_TEAM=price_...
STRIPE_PRICE_WHITELABEL=price_...
