# App
APP_NAME=hf-market-engine
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=hf_market_engine

# Receipt Graph v1.1 (paper mode)
# Leave both blank to generate a fresh in-process paper-only Ed25519 key at startup.
# If RECEIPT_SIGNING_PRIVATE_KEY_B64 is set, RECEIPT_SIGNING_KEY_ID is required.
# Never commit real private-key material; move live-stakes custody to KMS/HSM.
RECEIPT_SIGNING_KEY_ID=
RECEIPT_SIGNING_PRIVATE_KEY_B64=

# Market Data
COINGECKO_API_KEY=
POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# AI (optional)
OPENAI_API_KEY=
GROK_API_KEY=

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Stripe TEST MODE — see docs/STRIPE_TEST_MODE.md
# Dashboard (Test mode ON): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_pro
STRIPE_PRICE_ADVANCED=price_replace_advanced
STRIPE_PRICE_TEAM=price_replace_team
STRIPE_PRICE_WHITELABEL=
STRIPE_SUCCESS_URL=http://localhost:5173/pricing?upgraded=1
STRIPE_CANCEL_URL=http://localhost:5173/pricing?canceled=1
